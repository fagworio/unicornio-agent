# WordPress connection
CONTENT_SOURCE=mock
WORDPRESS_URL=http://wordpress.dvl.to:8080
WORDPRESS_API_BASE=/wp-json/wp/v2
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=

# Editorial agent safety
# Producao roda em write mode (o apply grava, sempre mantendo pending;
# a publicacao so acontece via publish-ready com PUBLISH_ENABLED).
EDITOR_DRY_RUN=false
# Limites mecanicos de custo: 5 posts por run (cards por lote) e 2 retries de
# download por fonte (alem da 1a tentativa) — trocar de fonte e mais barato
# que insistir em retry.
EDITOR_BATCH_LIMIT=5
EDITOR_MAX_POSTS_PER_RUN=5
EDITOR_MAX_SOURCE_RETRIES=2
# Primeiro observe em produção; só use enforce após revisar a telemetria.
# off é reservado a testes locais controlados (Devilbox).
EDITOR_REMOTE_URL_POLICY=audit
EDITOR_HTTP_TIMEOUT=15
EDITOR_LOCK_TTL=900
EDITOR_MIN_RELEVANCE_CONFIDENCE=0.80
# Gate de topicos do site (checklist): matched_topics precisa intersectar esta
# lista; vazio = gate desligado. Skip conservador: abaixo de
# EDITOR_MIN_SKIP_CONFIDENCE o post fica "uncertain" (pending, fora da fila).
EDITOR_MIN_SKIP_CONFIDENCE=0.90
SITE_TOPICS=games,xbox,playstation,nintendo,anime,cultura geek,streaming,series,cinema,filmes,tecnologia

# Vision gate (cinto de seguranca final no checklist de publicacao)
# Confirma com gpt-4o-mini que cada imagem publicada e visualmente consistente
# com o assunto (Structured Outputs {status, confidence, visual_type}; prompt
# restrito — metadados=contexto, pixels=evidencia). Cost-controlled:
#   * detail: low por padrao (~2833 tok/img); featured escala para high (13x)
#     apenas quando AMBIGUOUS; inline so low (descarta se nao confirmar).
#   * cache por hash(imagem)+entidade (work/vision_cache.json) evita re-analisar
#     a mesma key art em varios posts.
#   * limites mecanicos de chamadas por post (low/high).
# Chave: usa OPENAI_API_KEY (fallback: EDITOR_VISION_API_KEY).
# Fail-closed: habilitado sem chave (ou com erro de API) bloqueia a publicacao.
# So posts que passaram nos outros gates pagam chamadas de visao.
EDITOR_VISION_ENABLED=true
EDITOR_VISION_API_KEY=
EDITOR_VISION_BASE_URL=https://api.openai.com/v1
EDITOR_VISION_MODEL=gpt-4o-mini
EDITOR_VISION_DETAIL=low
# ambiguous (padrao): pula pixels apenas para pares oficiais de fonte+imagem
# com titulo identificavel; always: mantem visao em toda imagem de destaque.
EDITOR_VISION_MODE=ambiguous
EDITOR_VISION_MAX_LOW=12

# Loop de rework (verificar -> corrigir -> publicar): tentativas de correcao
# automatica por post. 1a falha do apply -> BLOCKED +30m; 2a -> +2h; 3a ->
# AWAITING_HUMAN (decisao humana: `unicornio-editor retry|discard POST_ID`).
EDITOR_MAX_REWORK_ATTEMPTS=3
EDITOR_REWORK_COOLDOWN_MINUTES=30
# Atribuicao exata no relatorio de custo: ID do job "UnicornioHater editorial
# pending". Se vazio ou a versao do Hermes nao armazenar esse campo, o
# relatorio/freio filtram pelo cwd/git_repo_root deste projeto.
HERMES_EDITORIAL_CRON_JOB_ID=
# Freio por janela móvel de 24h. Atribui pelo ID do job quando disponível; em
# state.db legado usa cwd/git_repo_root do projeto. Ajuste ao orçamento real.
HERMES_EDITORIAL_DAILY_COST_LIMIT_USD=1.20
# Orcamento de CONTEXTO da janela (0 = desligado). O dolar nao percebe regressao
# de contexto (75M tokens podem custar ~US$ 1 com deepseek-flash): estourado
# qualquer limite, o monitor nao acorda o LLM e a proxima janela comeca limpa —
# o checklist NUNCA e simplificado para caber no orcamento.
HERMES_EDITORIAL_WINDOW_REQUEST_LIMIT=0
HERMES_EDITORIAL_WINDOW_PROMPT_TOKEN_LIMIT=0
HERMES_EDITORIAL_WINDOW_INPUT_TOKEN_LIMIT=0
HERMES_EDITORIAL_WINDOW_CONTEXT_BYTES_LIMIT=0
# O limite de tokens e de PROMPT (input + cache_read + cache_write): o Hermes
# rele esse total a cada request e o cache-read e o que domina o gasto — olhar
# so `input_tokens` deixava o guard cego para "pouco input novo + milhoes
# relidos". INPUT_TOKEN_LIMIT continua aceito como alias (deprecated).
# Teto deterministico de buscas de imagem: apos N applies falhando em imagens
# (cada apply = 1 busca completa Bing->Google->Yandex + web_search), o codigo
# decide sozinho (artigo waiva inline com featured; listicle -> awaiting_human).
EDITOR_MAX_MEDIA_SEARCH_ATTEMPTS=2
# Versao da politica editorial embutida no Ready Manifest (mude ao alterar
# regras de checklist — posts READY antigos viram STALE e revalidam).
EDITOR_POLICY_VERSION=2

# ── Orcamento de SESSAO (hard cap de contexto) ───────────────────────────────
# A meta de producao e o teto de posts TOCADOS sao coisas diferentes: skipped,
# uncertain e blocked NAO consomem a meta de READY, e sem teto uma sessao podia
# tocar 8-15 posts acumulando contexto. Nenhum gate muda: o codigo apenas
# encerra a sessao e o proximo post fica para a proxima janela.
EDITOR_TARGET_READY_PER_RUN=5
EDITOR_MAX_POSTS_TOUCHED_PER_RUN=2
# Minutos de inatividade que separam duas sessoes (o ledger expira sozinho; sem
# isso o teto bloquearia a execucao seguinte do cron). PRECISA ser MENOR que o
# intervalo do cron editorial (default 90 min < 2h) — senao a execucao seguinte
# herda o teto esgotado da anterior.
EDITOR_SESSION_WINDOW_MINUTES=90
# Bytes de stdout que uma sessao pode consumir (0 = desligado).
EDITOR_SESSION_CONTEXT_BYTES_BUDGET=600000
# Margem de evidence_score para o `auto` do media-search-web (hipotese de
# calibracao: a telemetria cruza decisao x resultado dos gates para validar).
EDITOR_AUTO_SCORE_MARGIN=2

# Links internos (enriquecimento determinístico, sem IA): adiciona links para
# as categorias do portal na primeira ocorrencia de cada termo inequívoco,
# com link interno padrao (follow, sem target=_blank). Termos ambiguos/que
# dependem de contexto (ex.: "manga", "max" isolado, "teaser", "análise") NAO
# sao linkados automaticamente — uma string replace nao julga contexto.
EDITOR_INTERNAL_LINKS_ENABLED=true
