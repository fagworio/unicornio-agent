# WordPress connection
CONTENT_SOURCE=mock
WORDPRESS_URL=http://wordpress.dvl.to:8080
WORDPRESS_API_BASE=/wp-json/wp/v2
WORDPRESS_APP_USER=
WORDPRESS_APP_PASSWORD=

# Editorial agent safety
# Producao roda em write mode (o apply grava, sempre mantendo pending;
# a publicacao so acontece via publish-ready com PUBLISH_ENABLED).
EDITOR_DRY_RUN=false
# Limites mecanicos de custo: 2 posts por run (cards por lote), no maximo 3
# candidatos de midia por imagem e 2 retries de download por fonte (alem da
# 1a tentativa) — trocar de fonte e mais barato que insistir em retry.
EDITOR_BATCH_LIMIT=2
EDITOR_MAX_POSTS_PER_RUN=2
EDITOR_MAX_MEDIA_CANDIDATES=3
EDITOR_MAX_SOURCE_RETRIES=2
EDITOR_HTTP_TIMEOUT=15
EDITOR_LOCK_TTL=900
EDITOR_MIN_RELEVANCE_CONFIDENCE=0.80
# Gate de topicos do site (checklist): matched_topics precisa intersectar esta
# lista; vazio = gate desligado. Skip conservador: abaixo de
# EDITOR_MIN_SKIP_CONFIDENCE o post fica "uncertain" (pending, fora da fila).
EDITOR_MIN_SKIP_CONFIDENCE=0.90
SITE_TOPICS=games,xbox,playstation,nintendo,anime,cultura geek,streaming,series,cinema,filmes,tecnologia

# Vision gate (opcional, cinto de seguranca final no checklist de publicacao)
# Confirma com um modelo de visao (endpoint OpenAI-compativel) que cada imagem
# publicada retrata o assunto do alt. Fail-closed: habilitado sem chave (ou com
# erro de API) bloqueia a publicacao. So posts que passaram nos outros gates
# pagam chamadas de visao.
# EDITOR_VISION_ENABLED=false
# EDITOR_VISION_API_KEY=
# EDITOR_VISION_BASE_URL=https://api.openai.com/v1
# EDITOR_VISION_MODEL=gpt-4o-mini

# Loop de rework (verificar -> corrigir -> publicar): tentativas de correcao
# automatica por post. 1a falha do apply -> BLOCKED +30m; 2a -> +2h; 3a ->
# AWAITING_HUMAN (decisao humana: `unicornio-editor retry|discard POST_ID`).
EDITOR_MAX_REWORK_ATTEMPTS=3
EDITOR_REWORK_COOLDOWN_MINUTES=30
# Versao da politica editorial embutida no Ready Manifest (mude ao alterar
# regras de checklist — posts READY antigos viram STALE e revalidam).
EDITOR_POLICY_VERSION=2

# Links internos (enriquecimento determinístico, sem IA): adiciona links para
# as categorias do portal na primeira ocorrencia de cada termo inequívoco,
# com link interno padrao (follow, sem target=_blank). Termos ambiguos/que
# dependem de contexto (ex.: "manga", "max" isolado, "teaser", "análise") NAO
# sao linkados automaticamente — uma string replace nao julga contexto.
EDITOR_INTERNAL_LINKS_ENABLED=true
